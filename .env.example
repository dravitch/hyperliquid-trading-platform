# Copy this file to .env. Never commit .env or put the master-wallet private key in it.

# PUBLIC: master account used for balances, positions, orders and user events.
HYPERLIQUID_ACCOUNT_ADDRESS=

# PUBLIC: approved agent address, used only to verify operator intent.
HYPERLIQUID_AGENT_ADDRESS=

# PRIVATE: API/agent wallet signing keys (0x + 64 hexadecimal characters).
# Never use the MetaMask/master private key here.
HYPERLIQUID_TESTNET_PK=
HYPERLIQUID_MAINNET_PK=

# OPTIONAL PUBLIC addresses: leave empty unless intentionally using a vault.
HYPERLIQUID_TESTNET_VAULT=
HYPERLIQUID_MAINNET_VAULT=

# Fail-closed mainnet lock.
HLTRADER_MAINNET_ENABLED=false
